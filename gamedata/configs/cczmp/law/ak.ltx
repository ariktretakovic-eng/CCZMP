;; CCZMP - Chernobyl Criminal Zone MultiPlayer
;; Module: LAW
;; File:   ak.ltx -- АК НЧГ, Административный кодекс (5 статей, 18 составов)
;;
;; Same penalty grammar as uk.ltx. Administrative offences carry fines in
;; roubles and short arrests; they never carry freedom terms.
;; hook = the engine callback that can auto-report it, "none" if manual.

[ak]
list = ak_1_1, ak_1_2, ak_1_3, ak_2_1, ak_2_2, ak_2_3, ak_2_4, ak_3_1, ak_3_2, ak_3_3, ak_3_4, ak_4_1, ak_4_2, ak_4_3, ak_4_4, ak_5_1, ak_5_2, ak_5_3

; ---------------- Статья 1: Нарушение порядка ----------------
[ak_1_1]
number = 1.1
descr_key = cczmp_ak_1_1
penalty = fine:5000
hook = none
repeat = 1

[ak_1_2]
number = 1.2
descr_key = cczmp_ak_1_2
penalty = fine:10000, arrest:1
hook = none
repeat = 1

[ak_1_3]
number = 1.3
descr_key = cczmp_ak_1_3
penalty = fine:25000, arrest:2
hook = none
repeat = 0

