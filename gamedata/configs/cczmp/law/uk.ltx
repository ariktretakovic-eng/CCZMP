;; CCZMP - Chernobyl Criminal Zone MultiPlayer
;; Module: LAW
;; File:   uk.ltx -- УК НЧГ, Уголовный кодекс (11 статей, 35 составов)
;;
;; penalty grammar: comma-separated list of kind:amount
;;   fine:<rub>            штраф
;;   arrest:<hours>        арест, в часах (шкала: 1 игровой день = 1 час в реале)
;;   freedom:<years>       лишение свободы N лет ("3" or a range "1..5")
;;   seize_license         изъятие лицензии на оружие
;;   dismissal             увольнение (для сотрудников госструктур)
;;   reprimand             выговор
;;   demotion              понижение
;;   blacklist             внесение в ЧС организации
;;
;; hook names the engine callback that can auto-report this offence:
;;   none    -- reported by other modules or by hand
;;   npc_death, npc_fight, vehicle_enter, trade, interact
;; target tells the engine who has to be involved for it to fire:
;;   citizen, state, official, any, state_vehicle

[uk]
list = uk_1_1, uk_1_2, uk_1_3, uk_1_4, uk_1_5, uk_1_6, uk_2_1, uk_2_2, uk_2_3, uk_2_4, uk_2_5, uk_2_6, uk_2_7, uk_3_1, uk_3_2, uk_3_3, uk_4_1, uk_4_2, uk_4_3, uk_5_1, uk_5_2, uk_5_3, uk_5_4, uk_6_1, uk_6_2, uk_7_1, uk_7_2, uk_7_3, uk_8_1, uk_8_2, uk_9_1, uk_10_1, uk_10_2, uk_11_1, uk_11_2

; ---------------- Статья 1. Нанесение телесных травм / убийство ----------------
[uk_1_1]
number = 1.1
descr_key = cczmp_uk_1_1
penalty = freedom:3
hook = npc_fight
target = citizen
repeat = 0

[uk_1_2]
number = 1.2
descr_key = cczmp_uk_1_2
penalty = freedom:5
hook = npc_fight
target = state
repeat = 0

[uk_1_3]
number = 1.3
descr_key = cczmp_uk_1_3
penalty = freedom:5, seize_license
hook = npc_death
target = citizen
firearm = 1
repeat = 0

[uk_1_4]
number = 1.4
descr_key = cczmp_uk_1_4
penalty = freedom:5, seize_license
hook = npc_death
target = state
firearm = 1
repeat = 0

[uk_1_5]
number = 1.5
descr_key = cczmp_uk_1_5
penalty = freedom:3
hook = npc_death
target = citizen
firearm = 0
repeat = 0

[uk_1_6]
number = 1.6
descr_key = cczmp_uk_1_6
penalty = freedom:5
hook = npc_fight
target = official
repeat = 0

