;; CCZMP - Chernobyl Criminal Zone MultiPlayer
;; Module: NBZ (Narodny Bank Zony)
;; File:   insurance.ltx -- transport and property insurance
;;
;; Pricing rule derived from the brief: a policy costs less than the daily
;; rate multiplied by its length, and the difference is the discount.
;;   saving = day_price * days - price
;; So only day_price / week_price / month_price are stored; the script derives
;; every saving, and the whole table stays consistent if a price is retuned.
;;
;; classes whose `kind` is `transport` are matched against a vehicle's group;
;; classes whose `kind` is `property` are matched against a property id.

[insurance]
list = ins_car, ins_official, ins_offroad, ins_truck, ins_air, ins_house, ins_dormitory, ins_apartments, ins_business, ins_other

[ins_car]
kind = transport
name_key = cczmp_ins_car_name
day_price = 15000
week_price = 90000
month_price = 250000
covers = %trigger_vehicle_destroyed

[ins_official]
kind = transport
name_key = cczmp_ins_official_name
day_price = 25000
week_price = 150000
month_price = 450000
covers = %trigger_vehicle_destroyed

