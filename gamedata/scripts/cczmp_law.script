--[[
	CCZMP - Chernobyl Criminal Zone MultiPlayer
	Module: LAW -- УК / ФП / АК / Конституция НЧГ

	Enforcement engine: reports offences, parses the penalty grammar stored in
	cczmp/law/*.ltx and applies fines, arrests, custodial terms and service
	penalties, keeping a conviction record used for repeat-offence escalation.

	Design notes
	------------
	* ini_file() resolves against $game_config$ (gamedata\configs\), so the paths
	  below carry no "configs\" prefix. Getting that wrong yields an empty ini and
	  a fatal CInifile::r_section abort that no pcall can catch.
	* ready() validates every file once and disables the module instead of
	  letting a missing or renamed config take the game down.
	* Sentences persist independently of bounded conviction history, using a
	  genuine CTime start and a duration in game seconds. Terms run concurrently.
	* Reports are explicit adjudicated offences, not automatic combat detection.
	  Sentence tracking does not physically confine or teleport the actor.
]]

local CFG = "cczmp\\law\\"
local FILES = { "settings", "uk", "ak", "fp", "constitution" }

local f_settings, f_uk, f_ak, f_fp, f_constitution

local function ini(what)
	if f_settings     == nil and what == "settings"     then f_settings     = ini_file(CFG .. "settings.ltx")     end
	if f_uk           == nil and what == "uk"           then f_uk           = ini_file(CFG .. "uk.ltx")           end
	if f_ak           == nil and what == "ak"           then f_ak           = ini_file(CFG .. "ak.ltx")           end
	if f_fp           == nil and what == "fp"           then f_fp           = ini_file(CFG .. "fp.ltx")           end
	if f_constitution == nil and what == "constitution" then f_constitution = ini_file(CFG .. "constitution.ltx") end
	if what == "settings"     then return f_settings     end
	if what == "uk"           then return f_uk           end
	if what == "ak"           then return f_ak           end
	if what == "fp"           then return f_fp           end
	if what == "constitution" then return f_constitution end
	return nil
end

local function s(what, section, key, default)
	local f = ini(what)
	if type(section) ~= "string" or f == nil or not f:section_exist(section)
		or not f:line_exist(section, key) then return default end
	local v = f:r_string(section, key)
	if v == nil or v == "" then return default end
	return v
end

local function number(value)
	if type(value) ~= "number" and type(value) ~= "string" then return nil end
	local v = tonumber(value)
	if v == nil or v ~= v or math.abs(v) == math.huge then return nil end
	return v
end

local function n(what, section, key, default)
	local v = number(s(what, section, key, nil))
	if v == nil or v < 0 or v > 2147483647 then return default end
	return v
end

local function exists(what, section)
	local f = ini(what)
	return type(section) == "string" and f ~= nil and f:section_exist(section)
end

-- a comma separated "list" key, read from any section of any file
local function section_list(what, section)
	local out = {}
	for name in string.gmatch(s(what, section, "list", ""), "[^,%s]+") do
		out[#out + 1] = name
	end
	return out
end

local function list(what)
	return section_list(what, what)
end

local cfg_ready = nil

local function ready()
	if cfg_ready == nil then
		cfg_ready = true
		for _, what in ipairs(FILES) do
			if not exists(what, what) then
				cfg_ready = false
				printe("[CCZMP law] config not found: $game_config$%s%s.ltx -- module disabled", CFG, what)
				break
			end
		end
	end
	return cfg_ready
end

-- money ------------------------------------------------------------------

-- the engine exposes money(), give_money() and transfer_money(); there is no
-- take_money(), spending is just give_money() with a negative amount
local function wallet() return db.actor:money() end
local function take(v) db.actor:give_money(-v) end

-- time -------------------------------------------------------------------

local HOUR = 3600.0
local DAY  = 86400.0

local function now() return game.get_game_time() end

-- state ------------------------------------------------------------------

local SKEY = "cczmp_law"

local function state()
	local actor = db.actor
	if actor == nil then return nil end
	if not ready() then return nil end
	local st = alife_storage_manager.get_game_object_state(actor, true)
	if st[SKEY] == nil then
		st[SKEY] = {
			serial      = 0,
			convictions = {},
			debt        = 0,
			reprimands  = 0,
			demotions   = 0,
			dismissed   = false,
			blacklisted = false,
		}
	end
	local law = st[SKEY]
	law.sentences = law.sentences or {}
	return law
end

local function next_serial()
	local st = state()
	if st == nil then return nil end
	st.serial = (st.serial or 0) + 1
	return st.serial
end

local function ctime_key(prefix, id)
	return ("ccz_%s_%d_t"):format(prefix, id)
end

local function set_ctime(prefix, id, ct) save_ctime(db.actor, ctime_key(prefix, id), ct) end
local function get_ctime(prefix, id)      return load_ctime(db.actor, ctime_key(prefix, id)) end
local function clear_ctime(prefix, id)    save_ctime(db.actor, ctime_key(prefix, id), nil) end

local function elapsed_sec(prefix, id)
	local ct = get_ctime(prefix, id)
	if ct == nil then return nil end
	-- Old versions could write numbers where the engine expects CTime.
	if type(ct) ~= "userdata" and type(ct) ~= "table" then return nil end
	local ok, elapsed = pcall(function() return now():diffSec(ct) end)
	if not ok then return nil end
	return number(elapsed)
end

-- penalty grammar --------------------------------------------------------
-- "fine:5000, arrest:2" or bare flags such as "seize_license"
-- "freedom:1..5" is a range and becomes {min=, max=}

local function parse_penalty(raw)
	local out = {}
	local flags = {seize_license=true, dismissal=true, reprimand=true, demotion=true, blacklist=true}
	for part in string.gmatch(raw or "", "[^,]+") do
		part = string.gsub(part, "^%s*(.-)%s*$", "%1")
		if part ~= "" then
			local kind, amount = string.match(part, "^(%a+):(.+)$")
			if kind == nil then
				if not flags[part] then return nil end
				out[#out + 1] = { kind = part }
			elseif kind ~= "fine" and kind ~= "arrest" and kind ~= "freedom" then
				return nil
			elseif kind == "freedom" and string.find(amount, "%.%.") then
				local lo, hi = string.match(amount, "^(%d+)%.%.(%d+)$")
				lo, hi = number(lo), number(hi)
				if not lo or not hi or lo <= 0 or hi < lo or hi > 2147483647 then return nil end
				out[#out + 1] = { kind = kind, min = lo, max = hi }
			else
				amount = number(amount)
				if not amount or amount <= 0 or amount > 2147483647 then return nil end
				out[#out + 1] = { kind = kind, amount = amount }
			end
		end
	end
	if #out == 0 then return nil end
	return out
end

local function offence_code(id)
	for _, what in ipairs({ "uk", "ak", "fp" }) do
		for _, listed in ipairs(list(what)) do
			if listed == id and exists(what, id) then return what end
		end
	end
	return nil
end

-- repeat offences --------------------------------------------------------

local function prior_count(id, successor)
	local st = state()
	if st == nil then return 0 end
	local window = n("settings", "settings", "repeat_window_days", 30) * DAY
	local c = 0
	for i = 1, #st.convictions do
		local cnv = st.convictions[i]
		local elapsed = elapsed_sec("cnv", cnv.uid)
		if (cnv.id == id or cnv.id == successor) and elapsed ~= nil
			and elapsed >= 0 and elapsed <= window then
			c = c + 1
		end
	end
	return c
end

local function record_conviction(id, code, amount)
	local st = state()
	if st == nil then return nil end
	local uid = next_serial()
	st.convictions[#st.convictions + 1] = { id = id, code = code, amount = amount, uid = uid }
	set_ctime("cnv", uid, now())

	-- keep the record bounded
	local keep = math.max(1, math.floor(n("settings", "settings", "repeat_keep", 5)))
	while #st.convictions > keep * 4 do
		local old = table.remove(st.convictions, 1)
		clear_ctime("cnv", old.uid)
	end
	return uid
end

-- applying penalties -----------------------------------------------------

local function apply_fine(amount, mult)
	local due = math.min(2147483647, math.floor(amount * (mult or 1)))
	local have = wallet()
	if have >= due then
		take(due)
		return due, 0
	end
	local paid = have
	if paid > 0 then take(paid) end
	return paid, due - paid
end

local function sentence(uid, kind, duration)
	local st = state()
	set_ctime(kind, uid, now())
	st.sentences[#st.sentences + 1] = {uid = uid, kind = kind, duration = duration}
end

local function apply_arrest(hours, mult, uid)
	local h = math.floor(hours * (mult or 1))
	local cap = n("settings", "settings", "arrest_max_hours", 24)
	if h > cap then h = cap end
	if h <= 0 then return nil end
	sentence(uid, "arr", h * HOUR)
	return uid, h
end

-- Record the legal term in years and track a scaled duration; no confinement.
local function apply_freedom(years, mult, severity, uid)
	local st = state()
	if st == nil then return nil end

	local lo, hi = years, years
	-- years arrives either as a plain number or as a {min,max} range
	if type(years) == "table" and years.min ~= nil then
		lo, hi = years.min, years.max
		local t = severity or 0
		if t < 0 then t = 0 elseif t > 1 then t = 1 end
		years = math.floor(lo + (hi - lo) * t)
	end

	local scaled = years * (mult or 1)
	local per = n("settings", "settings", "freedom_year_days", 1)
	local days = scaled * per
	local dmin = n("settings", "settings", "freedom_year_days_min", 1)
	local dmax = n("settings", "settings", "freedom_year_days_max", 10)
	if days < dmin then days = dmin end
	if days > dmax then days = dmax end

	sentence(uid, "jail", days * DAY)
	st.last_term_years = scaled
	return uid, scaled, days
end

-- Seizure overrides the ownership info portion. Consumers must check
-- has_license() rather than testing that portion directly.
local function seize_license()
	local st = state()
	if st ~= nil then st.license_seized = true end
	return s("settings", "settings", "license_portion", "cczmp_weapon_license")
end

function has_license()
	local st = state()
	if st == nil then return false end
	if st.license_seized == true then return false end
	-- Ownership comes from the existing game info portion, never from absence
	-- of a seizure. This module has no licence issuance workflow.
	local ok, owned = pcall(function()
		return db.actor:has_info(s("settings", "settings", "license_portion", "cczmp_weapon_license"))
	end)
	return ok and owned == true
end

function restore_license()
	local st = state()
	if st == nil then return false end
	st.license_seized = false
	return has_license()
end

-- resolve one offence record into a concrete list of penalties ------------

local function faction_penalty(action)
	local ok, result = pcall(function()
		if cczmp_factions and type(cczmp_factions[action]) == "function" then
			return cczmp_factions[action]()
		end
		return false
	end)
	return ok and result == true
end

local function resolve_penalty(id, mult, severity, uid, penalties)
	local code = offence_code(id)
	if code == nil then return nil, "cczmp_law_msg_bad_offence" end

	local applied = {}
	for _, p in ipairs(penalties) do
		local r = { kind = p.kind }
		if p.kind == "fine" then
			local paid, owed = apply_fine(p.amount or 0, mult)
			r.paid, r.owed = paid, owed
			local st = state()
			if st ~= nil and owed > 0 and n("settings", "settings", "allow_debt", 1) == 1 then
				st.debt = st.debt + owed
				r.debt = st.debt
			end
		elseif p.kind == "arrest" then
			local sentence_uid, hours = apply_arrest(p.amount, mult, uid)
			r.uid, r.hours = sentence_uid, hours
		elseif p.kind == "freedom" then
			local years = (p.min ~= nil) and { min = p.min, max = p.max } or (p.amount or 1)
			local sentence_uid, term, days = apply_freedom(years, mult, severity, uid)
			r.uid, r.years, r.days = sentence_uid, term, days
		elseif p.kind == "seize_license" then
			r.portion = seize_license()
		elseif p.kind == "dismissal" then
			local st = state()
			if st ~= nil then st.dismissed = true end
			r.faction_applied = faction_penalty("leave")
		elseif p.kind == "reprimand" then
			local st = state()
			if st ~= nil then st.reprimands = (st.reprimands or 0) + 1 end
		elseif p.kind == "demotion" then
			local st = state()
			if st ~= nil then st.demotions = (st.demotions or 0) + 1 end
			r.faction_applied = faction_penalty("demote")
		elseif p.kind == "blacklist" then
			local st = state()
			if st ~= nil then st.blacklisted = true end
		end
		applied[#applied + 1] = r
	end
	return applied
end

-- the public entry point --------------------------------------------------

--[[
	report(id, amount, severity)
	  id       -- offence section, e.g. "ak_2_1" or "uk_1_4"
	  amount   -- value the offence was about; picks the ФП point when a rule
	             is split by threshold, and is stored with the conviction
	  severity -- 0..1, only used by a "lo..hi" range such as УК 9.1
	Returns true on success, or false plus a localisation key on refusal.
]]
function report(id, amount, severity)
	if type(id) ~= "string" then return false, "cczmp_law_msg_bad_offence" end
	if amount ~= nil then
		amount = number(amount)
		if amount == nil or amount < 0 or amount > 2147483647 then
			return false, "cczmp_law_msg_bad_offence"
		end
	end
	if severity ~= nil then
		severity = number(severity)
		if severity == nil or severity < 0 or severity > 1 then
			return false, "cczmp_law_msg_bad_offence"
		end
	end
	if not ready() then return false, "cczmp_law_msg_no_state" end
	local st = state()
	if st == nil then return false, "cczmp_law_msg_no_state" end

	local code = offence_code(id)
	if code == nil then return false, "cczmp_law_msg_bad_offence" end

	-- Only FP 4 is amount-based. Other high points are distinct conduct,
	-- except the four explicit repeat successors in the source brief.
	local chosen = id
	if id == "fp_4_low" or id == "fp_4_high" then
		if amount == nil then return false, "cczmp_law_msg_bad_offence" end
		local th = n("fp", "fp_4_low", "threshold", 10000)
		chosen = amount > th and "fp_4_high" or "fp_4_low"
	end

	local successors = {fp_6_low="fp_6_high", fp_7_low="fp_7_high",
		fp_9_low="fp_9_high", fp_10_low="fp_10_high"}
	local mult = 1
	local prior = prior_count(chosen, successors[chosen])
	if prior > 0 and successors[chosen] then
		chosen = successors[chosen]
	elseif prior > 0 and code == "ak" and n(code, chosen, "repeat", 0) == 1 then
		mult = math.max(1, n("settings", "settings", "repeat_multiplier", 2))
	end

	-- Validate the entire penalty before recording or applying any of it.
	if offence_code(chosen) ~= code then return false, "cczmp_law_msg_bad_offence" end
	local penalties = parse_penalty(s(code, chosen, "penalty", ""))
	if penalties == nil then return false, "cczmp_law_msg_bad_offence" end
	is_jailed() -- discard expired terms without depending on a UI query
	local uid = record_conviction(chosen, code, amount)
	local applied = resolve_penalty(chosen, mult, severity, uid, penalties)

	return true, nil, {
		id       = chosen,
		code     = code,
		number   = s(code, chosen, "number", ""),
		descr    = s(code, chosen, "descr_key", ""),
		prior    = prior,
		mult     = mult,
		penalties = applied,
		uid      = uid,
		alternative = s(code, chosen, "alternative", ""),
	}
end

-- queries ----------------------------------------------------------------

function is_jailed()
	local st = state()
	if st == nil then return false, 0 end
	local longest = 0
	for i = #st.sentences, 1, -1 do
		local term = st.sentences[i]
		local elapsed = elapsed_sec(term.kind, term.uid)
		local duration = number(term.duration)
		local left = elapsed and duration and duration - math.max(0, elapsed) or 0
		if left > 0 then
			longest = math.max(longest, left)
		else
			clear_ctime(term.kind, term.uid)
			table.remove(st.sentences, i)
		end
	end
	return longest > 0, longest
end

function jail_time_left()
	local jailed, left = is_jailed()
	if not jailed then return 0 end
	return left
end

function is_dismissed()
	local st = state()
	return st ~= nil and st.dismissed == true
end

function get_debt()
	local st = state()
	return st and st.debt or 0
end

function get_record()
	local st = state()
	if st == nil then return {} end
	local copy = {}
	for i, cnv in ipairs(st.convictions) do
		copy[i] = {}
		for key, value in pairs(cnv) do copy[i][key] = value end
	end
	return copy
end

-- service code helpers ---------------------------------------------------

-- Defaults to the low point, resolving amount/repeat branches in report().
-- Distinct conduct requires the optional point or a direct report(section).
function report_fp(rule, amount, point)
	if not ready() then return false, "cczmp_law_msg_no_state" end
	if type(rule) ~= "string" then return false, "cczmp_law_msg_bad_offence" end
	-- Optional explicit section selects conduct that amount/history cannot infer.
	if point ~= nil then
		if offence_code(point) == "fp" and s("fp", point, "rule", "") == rule then
			return report(point, amount)
		end
		return false, "cczmp_law_msg_bad_offence"
	end
	local id = rule .. "_low"
	if offence_code(id) == "fp" and s("fp", id, "rule", "") == rule then
		return report(id, amount)
	end
	return false, "cczmp_law_msg_bad_offence"
end

-- constitution -----------------------------------------------------------

function constitution_chapters()
	if not ready() then return {} end
	return list("constitution")
end

function chapter_articles(chapter)
	if not exists("constitution", chapter) then return {} end
	return section_list("constitution", chapter)
end

-- Interaction kinds are engine specific strings and the meaning of a "zone"
-- belongs to the map, so trespassing is not auto-detected here. A map script
-- calls interaction_offence() with its own marker id when the actor crosses in.
function interaction_offence(typ, obj)
	if is_jailed() then return false end
	if obj == nil then return false end

	-- The caller must establish unlawful entry, not merely zone proximity.
	local zone = typ
	local map = {
		army       = { "uk_5_1" },
		fsb_office = { "uk_5_2" },
		fsb        = { "uk_5_3" },
		mvd_parking = { "uk_5_4" },
		secure     = { "ak_3_1" },
		uniform    = { "ak_3_4" },
	}
	local set = map[zone]
	if set == nil then return false end
	for _, id in ipairs(set) do
		local ok, err = report(id)
		if not ok then return false, err end
	end
	return true
end

function on_game_start()
	-- Vanilla death callbacks carry victim/killer only, not jurisdiction,
	-- witnesses, self-defence or reliable weapon evidence. Never auto-convict.
	state()
end
