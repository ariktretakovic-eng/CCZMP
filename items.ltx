[pda_budget]:identity_immunity
GroupControlSection    = spawn_group
discovery_dependency   = 
$spawn                 = "devices\pda\pda_budget"
class                  = ITEM_PDA
cform                  = skeleton
visual                 = devices\pda\pda_budget.ogf
description            = st_pda_budget_descr
inv_name               = st_pda_budget
inv_name_short         = st_pda_budget_short
inv_weight             = 0.3
cost                   = 5000
inv_grid_width         = 2
inv_grid_height        = 1
inv_grid_x             = 10
inv_grid_y             = 10
slot                   = 8
default_to_ruck        = false
can_take               = true
quest_item             = false
device_type            = pda_budget

